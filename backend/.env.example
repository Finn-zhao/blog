# 生产环境统一使用 PostgreSQL；密码中的特殊字符必须 URL 编码。
DATABASE_URL=postgresql://blog:replace-with-url-encoded-password@127.0.0.1:5432/blog

# 必填：使用 python -c "import secrets; print(secrets.token_urlsafe(64))" 生成。
SECRET_KEY=replace-with-a-long-random-secret

# 浏览器允许来源，多个来源用英文逗号分隔，不要带结尾斜杠。
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

