# 生产环境统一使用 PostgreSQL；密码中的特殊字符必须 URL 编码。
DATABASE_URL=postgresql://qiguangji:replace-with-url-encoded-password@127.0.0.1:5432/qiguangji

# 必填：使用 python -c "import secrets; print(secrets.token_urlsafe(64))" 生成。
SECRET_KEY=replace-with-a-long-random-secret

# 浏览器允许来源，多个来源用英文逗号分隔，不要带结尾斜杠。
CORS_ORIGINS=https://blog.tianevan.com
# 仅填写实际反向代理服务器 IP；宝塔 Nginx 与后端同机时保留默认值。
TRUSTED_PROXY_IPS=127.0.0.1,::1

# GitHub OAuth。不开启访客登录时 Client ID/Secret 可留空。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_ORIGIN=https://blog.tianevan.com
GITHUB_CALLBACK_URL=https://blog.tianevan.com/api/auth/github/callback

# 腾讯云 COS。SecretId、SecretKey、地域和存储桶全部填写后启用；留空时保存到本地 uploads。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-beijing
# 完整存储桶名必须包含 APPID，例如 qiguangji-1250000000。
COS_BUCKET=
# 可选：绑定并启用 HTTPS 的自定义/CDN 域名；留空使用 COS 默认域名。
COS_CUSTOM_DOMAIN=
COS_PREFIX=blog/
